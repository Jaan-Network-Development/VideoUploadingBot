[Unit]
Description=VideoBot uploader - posts downloaded videos to the site
After=network-online.target xvfb.service
Wants=network-online.target
Requires=xvfb.service

[Service]
Type=simple
User=kvm
# same group as the downloader (user videobot) so it can read and delete the videos
SupplementaryGroups=videobot
UMask=0002
WorkingDirectory=/home/kvm/videodownloadbot/VideoBot
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:99
Environment=VIDEOBOT_DOWNLOADS=/var/lib/videobot/downloads
# Chrome draws on the virtual display from xvfb.service
ExecStart=/home/kvm/videodownloadbot/VideoBot/.venv/bin/python run.py --watch
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
